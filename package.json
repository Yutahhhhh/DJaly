{
  "name": "plumdeck",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "docker:start": "colima start plumdeck --cpu 5 --memory 8",
    "docker:stop": "colima stop plumdeck",
    "docker:restart": "colima stop plumdeck && colima start plumdeck --cpu 5 --memory 8",
    "backend:install": "sh backend/setup.sh",
    "backend:dev": "sh backend/run_backend.sh",
    "db:ui": "duckdb -ui",
    "db:cli": "backend/.venv/bin/harlequin -r db_data/plumdeck.duckdb",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "concurrently -k -n backend,tauri \"pnpm backend:dev\" \"TAURI_SKIP_SIDECAR=1 pnpm exec tauri dev\"",
    "dj-engine:build": "bash native/mixxx-engine-host/scripts/build-macos.sh",
    "dj-engine:stage": "bash native/mixxx-engine-host/scripts/stage-macos.sh",
    "tauri:build:performance": "test -x native/mixxx-engine-host/stage/PlumdeckMixxxHost.app/Contents/MacOS/plumdeck-mixxx-engine-host && pnpm exec tauri build --config src-tauri/tauri.mixxx.conf.json && bash native/mixxx-engine-host/scripts/sign-tauri-bundle-macos.sh",
    "release": "./scripts/release.sh",
    "pre-release": "./scripts/verify-release.sh",
    "restore:db": "cp db_data/plumdeck.duckdb \"$HOME/Library/Application Support/plumdeck/plumdeck.duckdb\"",
    "backup:db": "cp \"$HOME/Library/Application Support/plumdeck/plumdeck.duckdb\" backup/plumdeck.duckdb",
    "log:watch": "tail -f \"$HOME/Library/Application Support/plumdeck/logs/plumdeck.log\"",
    "local:restore-db": "backend/.venv/bin/python backend/transfer_db.py backup/plumdeck.duckdb db_data/plumdeck.duckdb",
    "prod:clean-db": "rm \"$HOME/Library/Application Support/plumdeck/plumdeck.duckdb\"",
    "prod:clean-db-w": "rm \"$HOME/Library/Application Support/plumdeck/plumdeck.duckdb.wal\"",
    "prod:restore-db": "backend/.venv/bin/python backend/transfer_db.py backup/plumdeck.duckdb \"$HOME/Library/Application Support/plumdeck/plumdeck.duckdb\"",
    "test:backend": "backend/.venv/bin/pytest backend/tests",
    "junction:signal:dev": "pnpm --dir services/junction-signaling build && pnpm --dir services/junction-signaling dev",
    "junction:test:contract": "pnpm --dir services/junction-signaling build && pnpm --dir services/junction-signaling test && node --experimental-strip-types --test src/services/junction/control-boundary.test.mjs",
    "junction:test:manual": "node --test native/mixxx-engine-host/tests/junction/manual-runtime.test.mjs",
    "junction:test:integration": "pnpm --dir services/junction-signaling build && node --test native/mixxx-engine-host/tests/junction/runtime.test.mjs",
    "junction:test:audio": "JUNCTION_AUDIO_DEVICE_TEST=1 native/mixxx-engine-host/build-junction/junction-core-tests program-output",
    "junction:test:ui": "tsc --noEmit && node --experimental-strip-types --test src/services/junction/control-boundary.test.mjs",
    "junction:test:network": "pnpm --dir services/junction-signaling build && native/mixxx-engine-host/build-junction/junction-core-tests media-transport && pnpm --dir services/junction-signaling test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.4.2",
    "@tauri-apps/plugin-http": "^2.5.4",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.555.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-lrc": "^3.2.1",
    "recharts": "2.15.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "vite": "^6.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
