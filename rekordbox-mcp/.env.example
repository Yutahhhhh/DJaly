# Rekordbox database (省略時は自動検出)
REKORDBOX_DB_PATH=
REKORDBOX_DB_KEY=
REKORDBOX_DB_DIR=

# readonly | xml | masterdb
REKORDBOX_MODE=readonly

# Backup policy
REKORDBOX_BACKUP_DIR=~/rekordbox-backups
REKORDBOX_BACKUP_MAX_DAYS=14
REKORDBOX_BACKUP_MAX_GENERATIONS=20
REKORDBOX_BACKUP_MAX_SIZE_GB=2.0
REKORDBOX_BACKUP_COMPRESSION_LEVEL=3

# Cue generation
REKORDBOX_CUE_PROFILE=default
REKORDBOX_CUE_MEMORY_OFFSET_BARS=16
REKORDBOX_CUE_LOOP_LENGTH_BARS=4
REKORDBOX_PHRASE_MIN_CONFIDENCE=0.5
REKORDBOX_VOCAL_MIN_CONFIDENCE=0.5

# Web API
REKORDBOX_WEBAPI_HOST=127.0.0.1
REKORDBOX_WEBAPI_PORT=8080
REKORDBOX_WEBAPI_ENABLED=false

# Web UI
REKORDBOX_WEBUI_HOST=127.0.0.1
REKORDBOX_WEBUI_PORT=3000
REKORDBOX_WEBUI_ENABLED=false

# DEBUG | INFO | WARNING | ERROR
REKORDBOX_LOG_LEVEL=INFO
# REKORDBOX_LOG_FILE=
