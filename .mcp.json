{
  "mcpServers": {
    "plumdeck": {
      "type": "http",
      "url": "http://127.0.0.1:48123/mcp"
    },
    "rekordbox": {
      "type": "stdio",
      "command": "${REKORDBOX_MCP_COMMAND:-rekordbox-mcp}",
      "args": ["--mode", "readonly"],
      "env": {
        "REKORDBOX_DB_PATH": "${REKORDBOX_DB_PATH}"
      }
    }
  }
}
